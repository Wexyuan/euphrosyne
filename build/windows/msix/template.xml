<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kairos.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Wexyuan\Kairos">
    </Installer>
    <PackageInformation
        PackageName="Kairos"
        PackageDisplayName="Kairos"
        PublisherName="CN=Wexyuan"
        PublisherDisplayName="Wexyuan"
        Version="0.1.0.0"
        PackageDescription="Kairos personal office desktop app">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.wexyuan.kairos"
                Description="Kairos personal office desktop app"
                DisplayName="Kairos"
                ExecutableName="kairos.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kairos</DisplayName>
            <PublisherDisplayName>Wexyuan</PublisherDisplayName>
            <Description>Kairos personal office desktop app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kairos.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>

{
  "name": "frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:dev": "run-p type-check \"build-only:dev {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:dev": "vite build --minify false --mode development",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "latest",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/mdi": "^1.2.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@unocss/eslint-plugin": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
